{
  "name": "serveflow",
  "version": "0.1.0",
  "private": true,
  "description": "ServeFlow — India-First Multi-Tenant Restaurant Operations SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "eslint": "8.57.0",
    "prettier": "3.3.2",
    "typescript": "5.4.5"
  }
}
