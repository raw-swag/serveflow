# Environment Configuration Template for ServeFlow

# Server / General
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
APP_NAME=ServeFlow
# Explicit permitted browser origins (comma-separated; never use '*' with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Client Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# PostgreSQL Database Connection (Phase 02 onwards)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serveflow?schema=public
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/serveflow?schema=public

# Redis Connection (Pub/Sub & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication (JWT)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# QR Code Token Signing Secret
QR_SIGNING_SECRET=qr-token-hmac-sha256-secret-change-in-production

# S3-Compatible Object Storage (MinIO / Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=serveflow-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/serveflow-assets

# Payment Gateway (Razorpay - India First)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# WhatsApp Business API (Optional / Notification Engine)
WHATSAPP_API_ENDPOINT=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Error Monitoring (Sentry)
SENTRY_DSN=
